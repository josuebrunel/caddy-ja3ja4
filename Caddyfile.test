{
	auto_https off
}

localhost:8443 {
	tls {$CERT_DIR:./testdata}/cert.pem {$CERT_DIR:./testdata}/key.pem

	ja3_ja4

	# One JSON access-log line per request, with the fingerprints appended.
	# Pretty-print with `make docker-logs`.
	log {
		output stdout
		format json
	}
	log_append ja3 {tls.ja3}
	log_append ja4 {tls.ja4}
	log_append ja3_raw {tls.ja3_raw}
	log_append ja3_sorted {tls.ja3_sorted}

	respond <<TXT
		JA3: {tls.ja3}
		JA4: {tls.ja4}
		JA3 Raw: {tls.ja3_raw}
		Sorted: {tls.ja3_sorted}
		TXT 200
}
